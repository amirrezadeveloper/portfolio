@inherits LayoutComponentBase
@inject NavigationManager Navigation

<PageTitle>@(IsPersian ? "امیررضا قهرمانی | توسعه‌دهندهٔ بک‌اند و دات‌نت" : "Amirreza Ghahremani | Backend Engineer & .NET Developer")</PageTitle>

<a class="skip-link" href="@(new Uri(Navigation.Uri).AbsolutePath + "#main-content")">@(IsPersian ? "رفتن به محتوای اصلی" : "Skip to content")</a>
<Navbar />
<main id="main-content">
    @Body
</main>
<Footer />

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase) || new Uri(Navigation.Uri).AbsolutePath.StartsWith("/fa/", StringComparison.OrdinalIgnoreCase);
}
