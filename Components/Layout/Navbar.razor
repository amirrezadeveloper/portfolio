@inject NavigationManager Navigation

<header class="site-header" id="site-header">
    <nav class="nav-shell container" aria-label="@(IsPersian ? "ناوبری اصلی" : "Main navigation")">
        <a class="brand" href="@SectionHref("home")" aria-label="@(IsPersian ? "امیررضا قهرمانی، بازگشت به ابتدا" : "Amirreza Ghahremani, back to top")">
            <span class="brand-mark" aria-hidden="true">AG<span>.</span></span>
            <span class="brand-name">@(IsPersian ? "امیررضا قهرمانی" : "Amirreza Ghahremani")</span>
        </a>
        <button class="menu-toggle" type="button" aria-label="@(IsPersian ? "باز کردن منوی ناوبری" : "Open navigation menu")" data-open-label="@(IsPersian ? "باز کردن منوی ناوبری" : "Open navigation menu")" data-close-label="@(IsPersian ? "بستن منوی ناوبری" : "Close navigation menu")" aria-controls="site-menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
        <div class="nav-panel" id="site-menu">
            <ul class="nav-links">
                <li><a href="@SectionHref("home")" class="nav-link active" aria-current="location">@(IsPersian ? "خانه" : "Home")</a></li>
                <li><a href="@SectionHref("about")" class="nav-link">@(IsPersian ? "دربارهٔ من" : "About")</a></li>
                <li><a href="@SectionHref("experience")" class="nav-link">@(IsPersian ? "تجربهٔ کاری" : "Experience")</a></li>
                <li><a href="@SectionHref("projects")" class="nav-link">@(IsPersian ? "پروژه‌ها" : "Projects")</a></li>
                <li><a href="@SectionHref("skills")" class="nav-link">@(IsPersian ? "مهارت‌ها" : "Skills")</a></li>
                <li><a href="@SectionHref("education")" class="nav-link">@(IsPersian ? "تحصیلات" : "Education")</a></li>
                <li><a href="@(IsPersian ? "/fa/blog" : "/blog")" class="nav-link">@(IsPersian ? "بلاگ" : "Blog")</a></li>
            </ul>
            <a href="@LanguageHref" data-enhance="false" class="language-switch" lang="@(IsPersian ? "en" : "fa")">@(IsPersian ? "English" : "فارسی")</a>
            <a href="@SectionHref("contact")" class="nav-contact">@(IsPersian ? "تماس با من" : "Let's talk") <span aria-hidden="true">↗</span></a>
        </div>
    </nav>
</header>

@code {
    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;
    private bool IsPersian => CurrentPath.Equals("/fa", StringComparison.OrdinalIgnoreCase) || CurrentPath.StartsWith("/fa/", StringComparison.OrdinalIgnoreCase);
    private string LanguageHref => CurrentPath.Contains("/blog", StringComparison.OrdinalIgnoreCase) ? (IsPersian ? "/blog" : "/fa/blog") : (IsPersian ? "/" : "/fa");
    private string SectionHref(string section) => $"{(IsPersian ? "/fa" : "/")}#{section}";
}
