@inject NavigationManager Navigation

<section id="home" class="hero" aria-labelledby="hero-heading">
    <div class="container hero-grid">
        <div class="hero-copy">
            <div class="eyebrow"><span class="eyebrow-line"></span> @(IsPersian ? "توسعه‌دهندهٔ بک‌اند و دات‌نت" : "BACKEND ENGINEER / .NET DEVELOPER")</div>
            <h1 id="hero-heading">@(IsPersian ? "من امیررضا" : "I'm Amirreza") <span>@(IsPersian ? "قهرمانی‌ام." : "Ghahremani.")</span></h1>
            <p class="hero-lead">@(IsPersian ? "توسعه‌دهندهٔ بک‌اند هستم و بیشتر با " : "I'm a backend developer working mainly with ")<bdi dir="ltr">C#</bdi>@(IsPersian ? " و " : " and ")<bdi dir="ltr">.NET</bdi>@(IsPersian ? " کار می‌کنم. طراحی API، کار با دیتابیس و توسعه و نگه‌داری برنامه‌های تحت وب، بخش اصلی کار من است." : ". I build APIs, work with databases, and develop and maintain web applications.")</p>
            <div class="hero-actions">
                <a class="btn btn-primary" href="@(IsPersian ? "/fa#projects" : "/#projects")">@(IsPersian ? "مشاهدهٔ پروژه‌ها" : "Explore my work") <span aria-hidden="true">↗</span></a>
                <a class="btn btn-ghost" href="mailto:amirrezaghahremani@gmail.com">@(IsPersian ? "تماس با من" : "Get in touch") <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="hero-visual">
            <div class="portrait-frame">
                <img src="profile.jpg" alt="@(IsPersian ? "عکس امیررضا قهرمانی" : "Portrait of Amirreza Ghahremani")" width="640" height="640" fetchpriority="high" />
            </div>
            <div class="visual-orbit" aria-hidden="true"></div>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
