@inject NavigationManager Navigation

<section id="skills" class="section" aria-labelledby="skills-title">
    <div class="container">
        <div class="section-heading reveal">
            <div><span class="section-kicker">@(IsPersian ? "۰۴ / مهارت‌ها" : "04 / SKILLS")</span><h2 id="skills-title">@(IsPersian ? "تکنولوژی‌ها و ابزارها" : "Technologies & tools")</h2></div>
            <p>@(IsPersian ? "در پروژه‌های مختلف با این‌ها کار کرده‌ام؛ انتخاب ابزار و ساختار، به نیاز همان پروژه بستگی دارد." : "These are tools and approaches I've used across different projects. The choice depends on what each project needs.")</p>
        </div>
        <div class="skills-grid">
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۱" : "01")</span><h3>@(IsPersian ? "بک‌اند و معماری" : "Backend & architecture")</h3><div class="tag-list"><span>C#</span><span>.NET</span><span>ASP.NET Core</span><span>ASP.NET MVC</span><span>Node.js</span><span>Monolith</span><span>Microservices</span><span>Clean Architecture</span><span>CQRS</span><span>MediatR</span><span>REST API</span></div></div>
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۲" : "02")</span><h3>@(IsPersian ? "دیتابیس و پیام‌رسانی" : "Databases & messaging")</h3><div class="tag-list"><span>EF Core</span><span>SQL Server</span><span>MongoDB</span><span>Redis</span><span>RabbitMQ</span><span>MassTransit</span><span>Elasticsearch</span></div></div>
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۳" : "03")</span><h3>@(IsPersian ? "زیرساخت و مانیتورینگ" : "Infrastructure & monitoring")</h3><div class="tag-list"><span>Docker</span><span>Kong API Gateway</span><span>Kibana</span><span>Grafana</span><span>Serilog</span><span>Git</span></div></div>
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۴" : "04")</span><h3>@(IsPersian ? "امنیت و ارتباط سرویس‌ها" : "Security & integrations")</h3><div class="tag-list"><span>JWT</span><span>OAuth</span><span>ASP.NET Identity</span><span>External APIs</span><span>OpenAPI / Swagger</span><span>gRPC</span><span>GraphQL</span></div></div>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
