@inject NavigationManager Navigation

<section id="skills" class="section" aria-labelledby="skills-title">
    <div class="container">
        <div class="section-heading reveal">
            <div><span class="section-kicker">@(IsPersian ? "۰۴ / مهارت‌ها" : "04 / TOOLKIT")</span><h2 id="skills-title">@(IsPersian ? "ابزارها و تخصص‌ها" : "Technical skills")</h2></div>
            <p>@(IsPersian ? "فناوری‌ها و الگوهایی که در طراحی، توسعه و نگه‌داری سامانه‌های بک‌اند از آن‌ها استفاده می‌کنم." : "Tools and patterns I use to build, connect, and operate backend systems.")</p>
        </div>
        <div class="skills-grid">
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۱" : "01")</span><h3>@(IsPersian ? "توسعهٔ بک‌اند و معماری" : "Backend & architecture")</h3><div class="tag-list"><span>C#</span><span>.NET</span><span>ASP.NET Core</span><span>Microservices</span><span>Clean Architecture</span><span>CQRS</span><span>MediatR</span><span>REST API</span></div></div>
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۲" : "02")</span><h3>@(IsPersian ? "داده و پیام‌رسانی" : "Data & messaging")</h3><div class="tag-list"><span>EF Core</span><span>SQL Server</span><span>Redis</span><span>RabbitMQ</span><span>MassTransit</span><span>Elasticsearch</span></div></div>
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۳" : "03")</span><h3>@(IsPersian ? "زیرساخت و پایش" : "Platform & observability")</h3><div class="tag-list"><span>Docker</span><span>Kong API Gateway</span><span>Kibana</span><span>Grafana</span><span>Serilog</span><span>Git</span></div></div>
            <div class="skill-group reveal"><span class="skill-index">@(IsPersian ? "۰۴" : "04")</span><h3>@(IsPersian ? "امنیت و یکپارچه‌سازی" : "Security & integration")</h3><div class="tag-list"><span>JWT</span><span>OAuth</span><span>ASP.NET Identity</span><span>External APIs</span><span>OpenAPI / Swagger</span><span>gRPC</span><span>GraphQL</span></div></div>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
