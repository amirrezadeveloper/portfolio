@inject NavigationManager Navigation

<section id="projects" class="section section-muted" aria-labelledby="projects-title">
    <div class="container">
        <div class="section-heading reveal">
            <div><span class="section-kicker">@(IsPersian ? "۰۳ / پروژه‌های منتخب" : "03 / SELECTED WORK")</span><h2 id="projects-title">@(IsPersian ? "پروژه‌ها و نمونه‌کارها" : "Projects & platforms")</h2></div>
            <p>@(IsPersian ? "نمونه‌ای از کارهای من در توسعهٔ سامانه‌های بیمه‌ای و تجارت الکترونیک. کد پروژه‌های سازمانی عمومی نیست." : "A selection of work described in my résumé. Enterprise project source code is not publicly linked.")</p>
        </div>
        <div class="projects-grid">
            <article class="project-card project-featured reveal">
                <div class="project-topline"><span class="project-number">@(IsPersian ? "۰۱" : "01")</span><span class="project-type">@(IsPersian ? "پروژهٔ شاخص · بیمه" : "FEATURED · INSURANCE")</span></div>
                <div class="project-content">
                    <div><h3>@(IsPersian ? "سامانهٔ میکروسرویسی رسیدگی به خسارت خودرو" : "Motor Insurance Claims Microservices Platform")</h3><p>@(IsPersian ? "این سامانهٔ سازمانی را از پایه طراحی و توسعه داده‌ام؛ از فرایند رسیدگی به خسارت و ارتباط بین سرویس‌ها تا اتصال به سامانه‌های بیرونی، احراز هویت، ثبت رویدادها و پایش عملکرد." : "Designed and developed an enterprise claims platform from scratch. The work spans claims workflows, service communication, external integrations, authentication, logging, monitoring, and infrastructure.")</p></div>
                    <div class="project-visual" aria-hidden="true"><span>@(IsPersian ? "درگاه API" : "API GATEWAY")</span><i></i><div><b>@(IsPersian ? "خسارت" : "Claims")</b><b>@(IsPersian ? "هویت" : "Identity")</b><b>@(IsPersian ? "سرویس‌های بیرونی" : "External APIs")</b></div><i></i><span>@(IsPersian ? "رویدادها · داده‌ها · پایش" : "EVENTS · DATA · OBSERVABILITY")</span></div>
                </div>
                <div class="tag-list"><span>.NET</span><span>Microservices</span><span>Clean Architecture</span><span>CQRS</span><span>RabbitMQ</span><span>Docker</span><span>Kong</span></div>
            </article>
            <article class="project-card reveal">
                <div class="project-topline"><span class="project-number">@(IsPersian ? "۰۲" : "02")</span><span class="project-type">@(IsPersian ? "صدور بیمه‌نامه" : "POLICY ISSUANCE")</span></div>
                <h3>@(IsPersian ? "سامانهٔ صدور بیمهٔ آتش‌سوزی تجاری" : "Commercial Fire Insurance Issuance Platform")</h3>
                <p>@(IsPersian ? "توسعهٔ سرویس‌های بک‌اند برای تعریف محصولات و صدور بیمه‌نامه؛ شامل قواعد کسب‌وکار، طرح‌های بیمه‌ای، مراحل صدور و ساختار پایگاه داده." : "Backend services for commercial fire insurance products and policy issuance, including business rules, product plans, policy workflows, and database structures.")</p>
                <div class="tag-list"><span>ASP.NET Core</span><span>EF Core</span><span>SQL Server</span><span>REST API</span></div>
            </article>
            <article class="project-card reveal">
                <div class="project-topline"><span class="project-number">@(IsPersian ? "۰۳" : "03")</span><span class="project-type">@(IsPersian ? "پورتال‌های سازمانی" : "ENTERPRISE PORTALS")</span></div>
                <h3>@(IsPersian ? "پورتال‌های سازمانی بیمه" : "Insurance Enterprise Portals")</h3>
                <p>@(IsPersian ? "مشارکت در توسعهٔ پورتال‌های شبکهٔ فروش، فروش الکترونیکی، بیمهٔ زندگی، بیمهٔ مجتمع‌های مسکونی و نظارت بر نمایندگان؛ از پیاده‌سازی فرایندها و سرویس‌های بک‌اند تا کار با داده و پشتیبانی سامانه." : "Sales network, electronic sales, life insurance, residential complex insurance, and representative monitoring portals. Delivered workflows, backend services, database work, and production support.")</p>
                <div class="tag-list"><span>.NET</span><span>ASP.NET MVC</span><span>Angular</span><span>SQL Server</span></div>
            </article>
            <article class="project-card reveal">
                <div class="project-topline"><span class="project-number">@(IsPersian ? "۰۴" : "04")</span><span class="project-type">@(IsPersian ? "فروش آنلاین" : "E-COMMERCE")</span></div>
                <h3>@(IsPersian ? "فروشگاه‌های آنلاین" : "E-commerce Platforms")</h3>
                <p>@(IsPersian ? "توسعهٔ امکانات نمایش محصولات، سبد خرید، ثبت سفارش و مدیریت مشتریان در فروشگاه قطعات موبایل یدک‌فون و یک سامانهٔ فروش مبتنی بر ASP.NET Core." : "Built commerce features for product catalogs, carts, orders, and customer management, including the YadakPhone mobile-parts website and an ASP.NET Core commerce platform.")</p>
                <div class="tag-list"><span>ASP.NET Core</span><span>Node.js</span><span>MongoDB</span><span>SQL Server</span></div>
            </article>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
