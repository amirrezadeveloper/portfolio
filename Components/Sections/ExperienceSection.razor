@inject NavigationManager Navigation

<section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container">
        <div class="section-heading reveal">
            <div><span class="section-kicker">@(IsPersian ? "۰۲ / تجربهٔ کاری" : "02 / EXPERIENCE")</span><h2 id="experience-title">@(IsPersian ? "سوابق کاری من" : "Where I've worked")</h2></div>
        </div>
        <div class="experience-list">
            <article class="experience-item reveal">
                <div class="experience-period">@(IsPersian ? "از ۲۰۲۳ تاکنون" : "2023 — PRESENT")</div>
                <div class="experience-detail">
                    <div class="experience-title"><h3>@(IsPersian ? "توسعه‌دهندهٔ نرم‌افزار" : "Developer")</h3><span>@(IsPersian ? "بیمه نوین" : "Novin Insurance")</span></div>
                    <p>@(IsPersian ? "روی توسعه و پشتیبانی نرم‌افزارها و پورتال‌های شرکت کار می‌کنم." : "I develop and support the company's applications and web portals.")</p>
                    <ul class="detail-list">
                        <li>@(IsPersian ? "توسعهٔ API و امکانات برنامه با ASP.NET Core و ASP.NET MVC." : "Building APIs and application features with ASP.NET Core and ASP.NET MVC.")</li>
                        <li>@(IsPersian ? "طراحی و تغییر دیتابیس، پیاده‌سازی منطق برنامه و اتصال به سرویس‌های دیگر." : "Designing and updating databases, implementing business logic, and integrating other services.")</li>
                        <li>@(IsPersian ? "کار روی احراز هویت و ارتباط بین سرویس‌ها؛ بررسی لاگ‌ها و رفع مشکلات محیط عملیاتی." : "Working on authentication and service communication, investigating logs, and fixing production issues.")</li>
                    </ul>
                </div>
            </article>
            <article class="experience-item reveal">
                <div class="experience-period">@(IsPersian ? "۲۰۲۲ تا ۲۰۲۳" : "2022 — 2023")</div>
                <div class="experience-detail">
                    <div class="experience-title"><h3>@(IsPersian ? "توسعه‌دهندهٔ وب" : "Web Developer")</h3><span>@(IsPersian ? "یدک‌فون" : "YadakPhone")</span></div>
                    <p>@(IsPersian ? "روی سایت فروش قطعات موبایل کار می‌کردم؛ از نمایش محصولات تا سبد خرید، ثبت سفارش و حساب کاربری." : "I worked on a mobile-parts store, including the product catalog, shopping cart, orders, and customer accounts.")</p>
                </div>
            </article>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
