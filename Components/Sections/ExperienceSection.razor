@inject NavigationManager Navigation

<section id="experience" class="section" aria-labelledby="experience-title">
    <div class="container">
        <div class="section-heading reveal">
            <div><span class="section-kicker">@(IsPersian ? "۰۲ / تجربهٔ کاری" : "02 / EXPERIENCE")</span><h2 id="experience-title">@(IsPersian ? "جایی که کار کرده‌ام" : "Where I've worked")</h2></div>
            <p>@(IsPersian ? "توسعهٔ سامانه‌های سازمانی و سرویس‌های بک‌اند برای فرایندهای مهم بیمه." : "Enterprise platforms, business-critical workflows, and dependable backend services.")</p>
        </div>
        <div class="experience-list">
            <article class="experience-item reveal">
                <div class="experience-period">@(IsPersian ? "از ۲۰۲۳ تاکنون" : "2023 — PRESENT")</div>
                <div class="experience-detail">
                    <div class="experience-title"><h3>@(IsPersian ? "توسعه‌دهندهٔ نرم‌افزار" : "Developer")</h3><span>@(IsPersian ? "بیمه نوین" : "Novin Insurance")</span></div>
                    <p>@(IsPersian ? "طراحی، توسعه و نگه‌داری سامانه‌های بیمه‌ای؛ از پلتفرم میکروسرویسی خسارت خودرو تا سامانهٔ صدور بیمهٔ آتش‌سوزی تجاری و پورتال‌های سازمانی." : "Designing and maintaining insurance software systems, including the motor claims microservices platform, commercial fire policy issuance, and enterprise portals.")</p>
                    <ul class="detail-list">
                        <li>@(IsPersian ? "طراحی و توسعهٔ APIهای ASP.NET Core با معماری پاک، CQRS و MediatR." : "Built ASP.NET Core APIs and services using Clean Architecture, CQRS, and MediatR.")</li>
                        <li>@(IsPersian ? "پیاده‌سازی لایهٔ داده با SQL Server، پیام‌رسانی با RabbitMQ و MassTransit، اتصال به سرویس‌های بیرونی و احراز هویت مبتنی بر JWT." : "Implemented SQL Server data access, RabbitMQ and MassTransit messaging, external integrations, and JWT authorization.")</li>
                        <li>@(IsPersian ? "راه‌اندازی محیط‌های توسعه با Docker و درگاه Kong؛ ثبت رویدادها و پایش سامانه با Serilog، Elasticsearch، Kibana و Grafana." : "Set up Docker development environments, Kong gateway, and observability with Serilog, Elasticsearch, Kibana, and Grafana.")</li>
                    </ul>
                </div>
            </article>
            <article class="experience-item reveal">
                <div class="experience-period">@(IsPersian ? "۲۰۲۲ تا ۲۰۲۳" : "2022 — 2023")</div>
                <div class="experience-detail">
                    <div class="experience-title"><h3>@(IsPersian ? "توسعه‌دهندهٔ وب" : "Web Developer")</h3><span>@(IsPersian ? "یدک‌فون" : "YadakPhone")</span></div>
                    <p>@(IsPersian ? "طراحی و پیاده‌سازی فروشگاه آنلاین قطعات موبایل با امکان نمایش محصولات، سبد خرید، ثبت سفارش و مدیریت حساب مشتریان با Node.js و MongoDB." : "Designed and implemented a mobile-parts e-commerce website with product catalog, cart, order processing, and customer features using Node.js and MongoDB.")</p>
                </div>
            </article>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
