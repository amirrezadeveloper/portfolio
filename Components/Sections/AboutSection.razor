@inject NavigationManager Navigation

<section id="about" class="section section-muted" aria-labelledby="about-title">
    <div class="container about-grid">
        <div class="section-intro reveal">
            <span class="section-kicker">@(IsPersian ? "۰۱ / دربارهٔ من" : "01 / ABOUT")</span>
            <h2 id="about-title">@(IsPersian ? "از طراحی سامانه" : "Thoughtful architecture.")<br /><span>@(IsPersian ? "تا توسعه و نگه‌داری" : "Practical delivery.")</span></h2>
        </div>
        <div class="about-body reveal">
            <p class="about-lead">@(IsPersian ? "بیش از سه سال است که با دات‌نت و معماری میکروسرویس‌ها، سامانه‌های سازمانی بیمه را توسعه می‌دهم." : "I'm a backend engineer with 3+ years of experience developing enterprise insurance systems with .NET and microservices.")</p>
            <p>@(IsPersian ? "در بیمه نوین، سامانهٔ رسیدگی به خسارت خودرو را از پایه طراحی و توسعه داده‌ام. کار من شامل طراحی سرویس‌ها، پیاده‌سازی مراحل رسیدگی به خسارت، اتصال به سامانه‌های دیگر، امنیت و پایش بوده است. در توسعهٔ سامانه‌های صدور بیمه‌نامه و پورتال‌های سازمانی هم مشارکت داشته‌ام." : "At Novin Insurance, I designed and built a motor claims platform from the ground up: service architecture, claim workflows, integrations, authentication, messaging, observability, and development infrastructure. I also work on policy issuance and enterprise portals where dependable business processes matter.")</p>
            <div class="about-highlights">
                <div><span>@(IsPersian ? "۰۱" : "01")</span><strong>@(IsPersian ? "طراحی معماری" : "System design")</strong><small>@(IsPersian ? "معماری پاک، CQRS و سرویس‌های توزیع‌شده" : "Clean Architecture, CQRS, distributed services")</small></div>
                <div><span>@(IsPersian ? "۰۲" : "02")</span><strong>@(IsPersian ? "پیاده‌سازی" : "Delivery")</strong><small>@(IsPersian ? "API، داده، یکپارچه‌سازی و پشتیبانی سامانه" : "APIs, data, integrations, production support")</small></div>
                <div><span>@(IsPersian ? "۰۳" : "03")</span><strong>@(IsPersian ? "پایداری سامانه" : "Reliability")</strong><small>@(IsPersian ? "امنیت، ثبت رویداد، پایش و عیب‌یابی" : "Security, logging, monitoring, debugging")</small></div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
