@inject NavigationManager Navigation

<section id="about" class="section section-muted" aria-labelledby="about-title">
    <div class="container about-grid">
        <div class="section-intro reveal">
            <span class="section-kicker">@(IsPersian ? "۰۱ / دربارهٔ من" : "01 / ABOUT")</span>
            <h2 id="about-title">@(IsPersian ? "چطور" : "How I") <span>@(IsPersian ? "کار می‌کنم" : "work")</span></h2>
        </div>
        <div class="about-body reveal">
            <p class="about-lead">@(IsPersian ? "هم روی پروژه‌هایی کار کرده‌ام که از صفر شروع شده‌اند، هم روی برنامه‌هایی که از قبل در حال استفاده بوده‌اند." : "I've worked on projects started from scratch and on applications that were already in use.")</p>
            <p>@(IsPersian ? "انتخاب معماری برایم به نیاز پروژه و شرایط تیم بستگی دارد؛ گاهی Monolith جواب می‌دهد و گاهی جدا کردن سرویس‌ها منطقی‌تر است. برایم مهم است کدی که می‌نویسم، بعداً برای خودم و بقیهٔ تیم قابل‌فهم و قابل‌تغییر باشد." : "The architecture depends on the project and the team. Sometimes a monolith fits; sometimes separate services make sense. I care about writing code that my teammates and I can understand and change later.")</p>
            <div class="about-highlights">
                <div><span>@(IsPersian ? "۰۱" : "01")</span><strong>@(IsPersian ? "شروع پروژه" : "Starting a project")</strong><small>@(IsPersian ? "بررسی نیازمندی‌ها و طراحی ساختار" : "Requirements and application structure")</small></div>
                <div><span>@(IsPersian ? "۰۲" : "02")</span><strong>@(IsPersian ? "کار روی کد موجود" : "Existing code")</strong><small>@(IsPersian ? "اضافه‌کردن امکانات و رفع اشکال" : "New features and bug fixes")</small></div>
                <div><span>@(IsPersian ? "۰۳" : "03")</span><strong>@(IsPersian ? "بعد از انتشار" : "After release")</strong><small>@(IsPersian ? "بررسی لاگ‌ها و پیگیری مشکلات" : "Reading logs and investigating issues")</small></div>
            </div>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
