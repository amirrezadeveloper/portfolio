@inject NavigationManager Navigation

<section id="education" class="section section-muted" aria-labelledby="education-title">
    <div class="container">
        <div class="section-heading reveal">
            <div><span class="section-kicker">@(IsPersian ? "۰۵ / تحصیلات" : "05 / EDUCATION")</span><h2 id="education-title">@(IsPersian ? "تحصیلات و دوره‌ها" : "Education & courses")</h2></div>
        </div>
        <div class="education-grid">
            <div class="education-primary reveal"><span class="card-label">@(IsPersian ? "کارشناسی · ۲۰۱۷ تا ۲۰۲۱" : "DEGREE · 2017–2021")</span><h3>@(IsPersian ? "کارشناسی مهندسی کامپیوتر" : "B.Sc. Computer Engineering")</h3><p>@(IsPersian ? "دانشگاه آزاد اسلامی" : "Islamic Azad University")</p><span class="education-note">@(IsPersian ? "معدل: ۱۶ از ۲۰" : "Cumulative GPA: 16/20")</span></div>
            <div class="education-courses reveal"><span class="card-label">@(IsPersian ? "دوره‌هایی که گذرانده‌ام" : "COURSES I'VE TAKEN")</span>
                <ul>
                    <li><strong>@(IsPersian ? "معماری API" : "API Architecture Styles")</strong><span>@(IsPersian ? "REST، gRPC و GraphQL در .NET 8 · سماتک" : "REST, gRPC & GraphQL in .NET 8 · Sematec")</span></li>
                    <li><strong>@(IsPersian ? "پیاده‌سازی و نگه‌داری SQL Server" : "SQL Server Implementation & Maintenance")</strong><span>@(IsPersian ? "سماتک" : "Sematec")</span></li>
                    <li><strong>@(IsPersian ? "برنامه‌نویسی Java SE 8" : "Java SE 8 Programming")</strong><span>@(IsPersian ? "مجتمع فنی تهران" : "Tehran Institute of Technology")</span></li>
                    <li><strong>@(IsPersian ? "برنامه‌نویسی اندروید" : "Android Programming")</strong><span>@(IsPersian ? "مجتمع فنی تهران" : "Tehran Institute of Technology")</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.Equals("/fa", StringComparison.OrdinalIgnoreCase);
}
