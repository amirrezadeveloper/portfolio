@page "/blog/{Slug}"
@page "/fa/blog/{Slug}"
@inject BlogClient Blog
@inject NavigationManager Navigation
@inject IHttpContextAccessor Context
@inject PublishedPostCatalog Catalog
@inject SiteMetadata Site

<section class="blog-page container article-shell">
    <nav class="breadcrumbs" aria-label="@(IsPersian ? "مسیر صفحه" : "Breadcrumb")"><ol><li><a href="@SiteMetadata.HomePath(Language)">@(IsPersian ? "خانه" : "Home")</a></li><li><a href="@SiteMetadata.BlogPath(Language)">@(IsPersian ? "بلاگ" : "Blog")</a></li>@if (Post != null) { <li aria-current="page">@Post.Title</li> }</ol></nav>
    <a class="blog-back" href="@(IsPersian ? "/fa/blog" : "/blog")">@(IsPersian ? "→ همهٔ مقاله‌ها" : "← All articles")</a>
    @if (Post != null)
    {
        <PageTitle>@Post.Title | @(IsPersian ? "امیررضا قهرمانی" : "Amirreza Ghahremani")</PageTitle>
        <HeadContent>
            <meta name="description" content="@Post.Excerpt" /><link rel="canonical" href="@Canonical" />
            @if (Translation != null)
            {
                <link rel="alternate" hreflang="@Language" href="@Canonical" />
                <link rel="alternate" hreflang="@Translation.Language" href="@Site.Url(Translation.Url)" />
                <link rel="alternate" hreflang="x-default" href="@Site.Url(Language == "en" ? Post.Url : Translation.Url)" />
            }
            <meta property="og:type" content="article" /><meta property="og:title" content="@Post.Title" />
            <meta property="og:description" content="@Post.Excerpt" /><meta property="og:url" content="@Canonical" />
            <meta property="og:site_name" content="Amirreza Ghahremani" /><meta property="og:image" content="@Site.Url("/profile.jpg")" />
            <meta property="og:image:alt" content="@(IsPersian ? "امیررضا قهرمانی، نویسندهٔ مقاله" : "Amirreza Ghahremani, article author")" />
            <meta property="article:published_time" content="@Post.PublishedAt?.ToString("O")" />
            <meta property="article:modified_time" content="@SiteMetadata.Modified(Post).ToString("O")" />
            <meta name="twitter:card" content="summary" /><meta name="twitter:title" content="@Post.Title" />
            <meta name="twitter:description" content="@Post.Excerpt" /><meta name="twitter:image" content="@Site.Url("/profile.jpg")" />
            <script type="application/ld+json">@((MarkupString)Site.ArticleJson(Post))</script>
        </HeadContent>
        <article><header class="article-heading">
            <div class="blog-meta">
                <a rel="author" href="@(SiteMetadata.HomePath(Language) + "#about")">@(IsPersian ? "امیررضا قهرمانی" : SiteMetadata.AuthorName)</a>
                <span>@(IsPersian ? "انتشار:" : "Published:") <time datetime="@Post.PublishedAt?.ToString("O")">@Post.DateLabel</time></span>
                @if (Post.PublishedAt is { } published && SiteMetadata.Modified(Post) > published.AddMinutes(1))
                { <span>@(IsPersian ? "به‌روزرسانی:" : "Updated:") <time datetime="@SiteMetadata.Modified(Post).ToString("O")">@SiteMetadata.Modified(Post).ToString("yyyy/MM/dd")</time></span> }
                <span>@Post.ReadingMinutes @(IsPersian ? "دقیقه مطالعه" : "min read")</span>
            </div>
            <h1>@Post.Title</h1><p>@Post.Excerpt</p>
            @if (Translation != null) { <a class="article-translation" href="@Translation.Url" lang="@Translation.Language" hreflang="@Translation.Language">@(IsPersian ? "Read this article in English →" : "← نسخهٔ فارسی این مقاله")</a> }
            <div class="tag-list">@foreach (var tag in Post.Tags) { <span>@tag</span> }</div>
        </header><div class="article-body">@((MarkupString)ArticleMarkdown.Render(Post.ContentMarkdown))</div></article>
        @if (Related.Count > 0)
        {
            <section class="related-posts" aria-labelledby="related-title"><h2 id="related-title">@(IsPersian ? "مطالب مرتبط" : "Related articles")</h2>
            <div class="blog-grid">@foreach (var related in Related) { <article class="blog-card"><h3><a href="@related.Url">@related.Title</a></h3><p>@related.Excerpt</p><a class="blog-read" href="@related.Url">@(IsPersian ? "خواندن مقاله ←" : "Read article →")</a></article> }</div></section>
        }
        <div class="article-contact"><p>@(IsPersian ? "اگر دربارهٔ این مطلب پرسشی دارید یا می‌خواهید دربارهٔ همکاری صحبت کنیم، پیام بدهید." : "Have a question or a project in mind?")</p><a class="btn btn-ghost" href="@(IsPersian ? "/fa#contact" : "/#contact")">@(IsPersian ? "تماس با من" : "Let's talk")</a></div>
    }
    else
    {
        <PageTitle>@(Failed ? "Blog unavailable" : "Article not found")</PageTitle>
        <div class="blog-empty"><h1>@(Failed ? (IsPersian ? "مقاله بارگذاری نشد" : "Article temporarily unavailable") : (IsPersian ? "مقاله پیدا نشد" : "Article not found"))</h1><p>@(IsPersian ? "برای دیدن نوشته‌های دیگر، به صفحهٔ بلاگ برگردید." : "Visit the blog to browse published articles.")</p></div>
    }
</section>

@code {
    [Parameter] public string Slug { get; set; } = "";
    private bool IsPersian => new Uri(Navigation.Uri).AbsolutePath.StartsWith("/fa/", StringComparison.OrdinalIgnoreCase);
    private string Language => IsPersian ? "fa" : "en";
    private string Canonical => Site.Url(Post?.Url ?? SiteMetadata.BlogPath(Language));
    private BlogPost? Post;
    private BlogPost? Translation;
    private IReadOnlyList<BlogPost> Related = [];
    private bool Failed;
    protected override async Task OnParametersSetAsync()
    {
        Failed = false;
        Post = null;
        Translation = null;
        Related = [];
        try { Post = await Blog.GetPublishedAsync(IsPersian ? "fa" : "en", Slug); }
        catch (Exception e) when (e is BlogApiException or HttpRequestException or TaskCanceledException) { Failed = true; }
        if (Post != null)
        {
            try
            {
                var metadata = await Catalog.GetAsync();
                Translation = metadata.FirstOrDefault(p => p.Slug == Post.Slug && p.Language != Language);
                Related = PublishedPostCatalog.Related(Post, metadata);
            }
            catch (Exception e) when (e is BlogApiException or HttpRequestException or TaskCanceledException) { /* The article remains readable if supplemental metadata is unavailable. */ }
        }
        if (Post == null && Context.HttpContext != null) Context.HttpContext.Response.StatusCode = Failed ? 503 : 404;
    }
}
